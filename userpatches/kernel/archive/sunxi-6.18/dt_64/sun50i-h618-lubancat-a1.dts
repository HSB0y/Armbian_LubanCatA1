// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * EmbedFire LubanCat-A1 (Allwinner H618)
 *
 * Port: AXP1530(=AXP313a) PMIC on r_i2c; LPDDR4; AIC8800 SDIO WiFi + UART BT;
 * GPIO LED on PF6; SD on mmc0 (CD PH4); eMMC on mmc2; ext RGMII GbE on emac0.
 */

/dts-v1/;

#include "sun50i-h616.dtsi"
#include "sun50i-h616-cpu-opp.dtsi"
#include "sun50i-h616-gpu-opp.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "EmbedFire LubanCat-A1";
	compatible = "embedfire,lubancat-a1", "allwinner,sun50i-h618";

	aliases {
		ethernet0 = &emac0;
		serial0 = &uart0;
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "d";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pio 5 6 GPIO_ACTIVE_HIGH>; /* PF6 */
			linux,default-trigger = "heartbeat";
		};
	};

	reg_vcc5v: regulator-vcc5v {
		/* board-wide 5V supply */
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "vcc-5v";
	};

	reg_usb_vbus: regulator-usb-vbus {
		/* PG14 enables the shared 5V rail for all USB ports */
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_vcc5v>;
		gpio = <&pio 6 14 GPIO_ACTIVE_HIGH>; /* PG14 */
		enable-active-high;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "ext_clock";
		pinctrl-0 = <&x32clk_fanout_pin>;
		pinctrl-names = "default";
		post-power-on-delay-ms = <200>;
		power-off-delay-us = <5000000>;
		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>, /* PG18 WiFi EN */
			      <&pio 6 17 GPIO_ACTIVE_LOW>; /* PG17 BT EN */
	};
};

&ahub_dam_plat {
	status = "okay";
};

/* AHUB hardware-mix card; required for HDMI audio routing/clocking. */
&ahub_dam_mach {
	status = "okay";
};

&ahub1_plat {
	status = "okay";
};

&ahub1_mach {
	status = "okay";
};

&codec {
	status = "okay";
	allwinner,audio-routing = "Line Out", "LINEOUT";
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

&de {
	status = "okay";
};

&emac0 {
	status = "okay";
	pinctrl-0 = <&ext_rgmii_pins>;
	pinctrl-names = "default";
	phy-mode = "rgmii";
	phy-handle = <&ext_rgmii_phy>;
	allwinner,tx-delay-ps = <700>;
	allwinner,rx-delay-ps = <2000>;
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

&gpu {
	status = "okay";
	mali-supply = <&reg_dcdc1>;
};

&hdmi {
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&ir {
	status = "okay";
	pinctrl-0 = <&ir_rx_pin>;
	pinctrl-names = "default";
};

&mdio0 {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

/* SD card */
&mmc0 {
	status = "okay";
	bus-width = <4>;
	cd-gpios = <&pio 7 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PH4 */
	disable-wp;
	max-frequency = <50000000>;
	vmmc-supply = <&reg_dldo1>;
};

/* SDIO WiFi (AIC8800) */
&mmc1 {
	status = "okay";
	bus-width = <4>;
	keep-power-in-suspend;
	max-frequency = <100000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_aldo1>;

	sdio: wifi@1 {
		reg = <1>;
	};
};

/* eMMC */
&mmc2 {
	status = "okay";
	bus-width = <8>;
	cap-mmc-hw-reset;
	mmc-hs200-1_8v;
	non-removable;
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_aldo1>;
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

&pio {
	vcc-pc-supply = <&reg_dldo1>;
	vcc-pf-supply = <&reg_dldo1>;
	vcc-pg-supply = <&reg_aldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;
	vcc-pl-supply = <&reg_aldo1>;

	ext_rgmii_pins: rgmii-pins {
		pins = "PI0", "PI1", "PI2", "PI3", "PI4",
		       "PI5", "PI7", "PI8", "PI9", "PI10",
		       "PI11", "PI12", "PI13", "PI14", "PI15";
		function = "emac0";
		drive-strength = <40>;
	};
};

&r_i2c {
	status = "okay";

	axp313: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;
		wakeup-source;
		#interrupt-cells = <1>;
		interrupt-controller;
		interrupt-parent = <&pio>;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			reg_aldo1: aldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-1v8-pll";
			};

			reg_dldo1: dldo1 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-3v3-io";
			};

			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <990000>;
				regulator-name = "vdd-gpu-sys";
			};

			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <200>;
				regulator-name = "vdd-cpu";
			};

			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd-dram";
			};
		};
	};
};

&spi1 {
	status = "disabled";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_ph_pins>;
	pinctrl-names = "default";
};

/* Bluetooth (AIC8800 HCI UART) */
&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
};

&usbotg {
	status = "okay";
	dr_mode = "otg";
};

&usbphy {
	status = "okay";
	usb0_vbus-supply = <&reg_usb_vbus>;
	usb1_vbus-supply = <&reg_usb_vbus>;
	usb2_vbus-supply = <&reg_usb_vbus>;
	usb3_vbus-supply = <&reg_usb_vbus>;
};